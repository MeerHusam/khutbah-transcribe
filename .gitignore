.env
.env.*
!.env.example
node_modules/
uploads/
data/
# autopublish.js and upload_worker.js logs, on the Mac only
logs/
*.log
.DS_Store
# All local Python environments (.venv-align, .venv-clean)
.venv*
__pycache__/

# faster-whisper / HuggingFace model cache
models/
# Paid voice audio kept per request (voice/tts_gemini.mjs), so nothing is paid for twice.
.tts_cache/
*.bin
*.safetensors

# Hadith corpus — pipeline-only; the listening server reads refs straight from
# each result.json, so it does not need hadith_data/ at runtime.
hadith_data/

# ── Recordings and pipeline runs: on the Mac only ─────────────────────────────
# The site's copies are on Render's disk (text) and Cloudflare R2 (audio), put there by the
# publish API (worker/site.js). tests/fixture/ is one run's text, for the tests.
audio_files/
outputs/
*.mp3
*.m4a
*.ogg
*.wav
*.mp4
*.flac
.claude/settings.local.json
