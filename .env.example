# Transcription / analysis API keys
OPENAI_API_KEY=          # OpenAI whisper-1 (default transcription mode)
ANTHROPIC_API_KEY=       # Claude analysis (required)
GROQ_API_KEY=            # Groq whisper-large-v3 (--groq, recommended)
GEMINI_API_KEY=          # Gemini 2.5 Flash text (--gemini hybrid)

# Streaming live mode (/stream) — realtime Arabic ASR + AR→EN translation.
# Free tier: 40 hours/month. Sign up at https://portal.speechmatics.com
# Not needed for the upload pipeline or the chunk-based /live mode.
SPEECHMATICS_API_KEY=
SPEECHMATICS_MAX_DELAY=1.0   # 0.7–4s. Lower = faster finals, slightly less accurate

# Authoritative hadith number/link lookup — https://hadithapi.com (free, register for key)
HADITH_API_KEY=
