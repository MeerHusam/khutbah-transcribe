# Copy to .env (never committed). Every script loads it from the working directory, so run
# them from the repo root.

# ── Pipeline (pipeline.js, worker/autopublish.js) ────────────────────────────────
ANTHROPIC_API_KEY=      # Claude: analysis, quote swaps, Urdu, titles, voice directions (required)
GEMINI_API_KEY=         # Gemini: the transcript text (default mode) and the voice tracks
GROQ_API_KEY=           # Groq Whisper: word timings (always) and --groq transcription; free tier

# ── Voice tracks (optional) ──────────────────────────────────────────────────────
ELEVEN_LABS_API_KEY=    # only for voice/tts.js --engine elevenlabs (paid credits)

# ── Site and upload worker ───────────────────────────────────────────────────────
ADMIN_TOKEN=            # key for /admin/… and the publish API; on the Mac, the same value as on Render
# SITE_URL=https://khutbah-live.onrender.com   # the site the upload worker and autopublish.js publish to
# AUTOPUBLISH_ARGS=     # extra arguments the worker passes to autopublish.js, e.g. --no-push
# PORT=3000             # the server's port
# DATA_DIR=             # where the server keeps counts, feedback and uploads (default <root>/data)

# ── Rarely needed ────────────────────────────────────────────────────────────────
# KT_SWAP_MODEL=        # a different model for the quote swaps (core/quote_swaps.js)
